{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "cd cloud-ttml-bot && pnpm install --no-frozen-lockfile && pnpm run build"
  },
  "deploy": {
    "startCommand": "cd cloud-ttml-bot && pnpm start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
